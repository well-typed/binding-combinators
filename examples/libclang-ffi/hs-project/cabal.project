import: ../../../cabal.project.base

-- The point of this example is to build over libclang's RAW Clang.LowLevel.FFI. Upstream
-- libclang-bindings keeps that module (and the Clang.Internal.* / Clang.LowLevel.Core.*
-- plumbing it is written in terms of) as other-modules, so the version on Hackage does
-- not let a downstream package import the substrate at all. We therefore depend on a
-- local, lightly-patched copy that re-exposes those modules (see
-- ../libclang-bindings/libclang-bindings.cabal, materialised by generate-and-run.sh);
-- the `packages:` entry below shadows the Hackage version.

packages:
  .
  ../libclang-bindings
  ../../..
